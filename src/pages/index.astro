---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const last_posts = posts.slice(0, 3);
---

<BaseLayout
  title="Mayo Racek | Data Analyst & Engineer"
  description="Designing trustworthy data systems from collection and modelling to activation, conversational analytics and AI agents."
  sideBarActiveItemID="home"
>
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hi there👋</div>

    <div class="text-5xl font-bold"> I’m Mayo Racek</div>

    <div class="text-2xl py-3 font-semibold">
     >Data Analyst & Engineer designing trustworthy data solutions.
    </div>

    <div class="py-2">
      <p class="text-lg mb-4">
        I help turn fragmented tracking and raw event data into reliable,
        governed data products that people, businesses and AI systems can
        actually use.
      </p>

      <p class="text-lg mb-4">
        My work covers the complete data journey: measurement architecture,
        first-party collection, BigQuery modelling, data quality, activation,
        monitoring and conversational analytics.
      </p>

      <p class="text-lg">
        This website is where I document the systems I build, the problems I
        solve and the lessons learned along the way.
      </p>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn" href="/projects">Explore my projects</a>

      <a class="btn btn-outline" href="/blog/">
        Read the blog
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">
      Selected projects {"</>"}
    </div>
  </div>

  <HorizontalCard
    title="First-Party Analytics Pipeline"
    img="/post_img.webp"
    desc="A governed first-party analytics system covering anonymous identity, event collection, Server GTM, BigQuery modelling, traffic-source attribution and future AI-assisted insights."
    url="/blog/first-party-analytics-pipeline"
    target="_self"
    badge="BUILDING IN PUBLIC"
    tags={["Analytics Engineering", "Server GTM", "BigQuery"]}
  />

  <div class="divider my-0"></div>

  <HorizontalCard
    title="Polaris FC Universe"
    img="/post_img.webp"
    desc="A constraint-valid football data universe designed for analytics engineering, player development, governed decision support and future football intelligence agents."
    url="/blog/polaris-fc-universe"
    target="_self"
    badge="FOOTBALL DATA"
    tags={["Football Analytics", "Data Engineering", "AI Agents"]}
  />

  <div class="divider my-0"></div>

  <HorizontalCard
    title="GTM Operations Agent"
    img="/post_img.webp"
    desc="An ADK multi-agent system that connects to the Google Tag Manager API to audit containers, detect duplication and race-condition risks, propose safe improvements, execute approved changes and report conversationally on GTM governance."
    url="/projects"
    target="_self"
    badge="FLAGSHIP BUILD"
    tags={["ADK", "GTM API", "Multi-Agent System", "Governance"]}
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">
      Latest from the blog
    </div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
          tags={post.data.tags}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
